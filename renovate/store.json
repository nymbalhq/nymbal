{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Nymbal stores: every Nymbal package in one pull request per release, and nothing merges itself.",
  "extends": ["config:recommended"],
  "platformAutomerge": false,
  "osvVulnerabilityAlerts": true,
  "packageRules": [
    {
      "groupName": "Nymbal",
      "matchPackageNames": [
        "@nymbalhq/stack",
        "nymbal",
        "@nymbalhq/config",
        "@nymbalhq/platform",
        "@nymbalhq/sdk",
        "@nymbalhq/types",
        "@nymbalhq/web-components",
        "@nymbalhq/http",
        "@nymbalhq/react",
        "@nymbalhq/admin",
        "@nymbalhq/contract-tests"
      ]
    }
  ],
  "vulnerabilityAlerts": {
    "groupName": "Nymbal security",
    "labels": ["security"]
  }
}
