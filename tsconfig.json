{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx"
  },
  "include": [
    "packages/*/src/**/*",
    "packages/adapters/*/*/src/**/*",
    "packages/*/tests/**/*",
    "packages/*/test/**/*",
    "packages/adapters/*/*/tests/**/*",
    "tests/**/*.ts",
    "scripts/**/*.ts",
    "vitest.config.ts"
  ],
  "exclude": ["**/node_modules", "**/dist", "**/.astro", "**/.next", "templates/**"]
}
