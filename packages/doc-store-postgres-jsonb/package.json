{
  "name": "@nymbalhq/doc-store-postgres-jsonb",
  "version": "1.1.0",
  "description": "The Postgres JSONB document store for Nymbal: `infrastructure.documentStore: 'postgres-jsonb'`",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nymbalhq/nymbal.git",
    "directory": "packages/doc-store-postgres-jsonb"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit --rootDir ../.."
  },
  "dependencies": {
    "@nymbalhq/types": "workspace:*"
  },
  "peerDependencies": {
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@nymbalhq/contract-tests": "workspace:*",
    "@types/pg": "^8.11.10",
    "@typescript/native": "npm:typescript@^7.0.2",
    "fast-check": "^4.10.2",
    "pg": "^8.13.1",
    "tsup": "^9.0.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^3.0.0"
  }
}
