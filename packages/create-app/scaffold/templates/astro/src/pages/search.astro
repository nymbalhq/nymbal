---
import '../styles/pages/search.css'
import BaseLayout from '../layouts/BaseLayout.astro'
---

<BaseLayout title="Search | Nymbal" description="Search our product catalogue.">
  <div class="search-hero">
    <h1 class="search-hero-title">Search</h1>
    <div class="search-bar-wrapper">
      <input
        type="search"
        id="search-input"
        class="search-input-large"
        placeholder="Search for products..."
        aria-label="Search products"
        data-testid="search-page-input"
        autocomplete="off"
      />
    </div>
  </div>

  <div class="container section">
    <div class="search-layout">
      <aside class="search-sidebar">
        <nymbal-product-filter source="search" empty></nymbal-product-filter>
      </aside>
      <nymbal-search-results data-testid="search-results"></nymbal-search-results>
    </div>
  </div>
</BaseLayout>

<script>
  import '../scripts/search.js'
</script>
