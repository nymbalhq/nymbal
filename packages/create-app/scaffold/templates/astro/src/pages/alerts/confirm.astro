---
import '../../styles/pages/error.css'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { confirmAlert } from '../../lib/api'

// Opening the link only shows the button, so a mail scanner that fetches it confirms nothing. The press posts the
// token back here, and this server posts it on to the API, so the browser needs no CSRF cookie.
const pressed = Astro.request.method === 'POST'
const token = pressed
  ? String((await Astro.request.formData()).get('token') ?? '')
  : (Astro.url.searchParams.get('token') ?? '')
const confirmed = pressed && token !== '' ? await confirmAlert(token) : null
---

<BaseLayout title="Email alert | Nymbal" description="Confirm your email alert.">
  {!pressed && token !== '' ? (
    <form method="post" class="error-page" data-testid="alert-confirm-form" id="alert-link-form">
      <h1 class="error-title">Confirm your email alert</h1>
      <p class="error-message">Press the button to start the alert this email asked for.</p>
      <input type="hidden" name="token" value={token} />
      <div class="error-actions">
        <button type="submit" class="btn btn-primary" data-testid="alert-confirm-submit">Confirm alert</button>
      </div>
    </form>
  ) : confirmed ? (
    <div class="error-page" data-testid="alert-confirmed" data-kind={confirmed.kind}>
      <h1 class="error-title">Your alert is on</h1>
      {confirmed.kind === 'price_drop' ? (
        <p class="error-message">
          We'll email you when the price of <a href={`/product/${confirmed.product.slug}`}>{confirmed.product.name}</a> drops.
        </p>
      ) : (
        <p class="error-message">
          We'll email you once when <a href={`/product/${confirmed.product.slug}`}>{confirmed.product.name}</a> is back
          in stock.
        </p>
      )}
    </div>
  ) : (
    <div class="error-page" data-testid="alert-link-invalid">
      <h1 class="error-title">This link is not valid</h1>
      <p class="error-message">It may be from an older email, or the alert has been stopped.</p>
      <div class="error-actions">
        <a href="/products" class="btn btn-primary">Browse Products</a>
      </div>
    </div>
  )}
</BaseLayout>

<script>
  import { submitOnce } from '../../lib/submit-once'

  // The native submit sends the form once; a second click or Enter while it is on its way is ignored.
  const form = document.getElementById('alert-link-form') as HTMLFormElement | null
  submitOnce(form, () => {
    form?.submit()
    return 'leaving'
  })
</script>
