---
import '../../styles/pages/error.css'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { confirmAlert } from '../../lib/api'

// The link in a confirmation email: the token is posted from this server, so the browser needs no CSRF cookie.
const token = Astro.url.searchParams.get('token') ?? ''
const confirmed = token === '' ? null : await confirmAlert(token)
---

<BaseLayout title="Email alert | Nymbal" description="Confirm your email alert.">
  {confirmed ? (
    <div class="error-page" data-testid="alert-confirmed" data-kind={confirmed.kind}>
      <h1 class="error-title">Your alert is on</h1>
      {confirmed.kind === 'price_drop' ? (
        <p class="error-message">
          We'll email you when the price of <a href={`/product/${confirmed.product.slug}`}>{confirmed.product.name}</a> drops.
        </p>
      ) : (
        <p class="error-message">
          We'll email you once when <a href={`/product/${confirmed.product.slug}`}>{confirmed.product.name}</a> is back
          in stock.
        </p>
      )}
    </div>
  ) : (
    <div class="error-page" data-testid="alert-link-invalid">
      <h1 class="error-title">This link is not valid</h1>
      <p class="error-message">It may be from an older email, or the alert has been stopped.</p>
      <div class="error-actions">
        <a href="/products" class="btn btn-primary">Browse Products</a>
      </div>
    </div>
  )}
</BaseLayout>
