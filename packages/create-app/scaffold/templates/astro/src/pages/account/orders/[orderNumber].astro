---
import '../../../styles/pages/account.css'
import '../../../styles/pages/confirmation.css'
import AccountLayout from '../../../layouts/AccountLayout.astro'
---

<AccountLayout title="Order Detail">
  <div id="order-detail-container" data-testid="order-detail" data-order-number={Astro.params.orderNumber}>
    <p style="color: var(--nymbal-color-text-muted, #71717a); font-size: var(--nymbal-font-size-sm, 0.875rem);">
      Loading order details...
    </p>
  </div>
</AccountLayout>

<script>
  import { client } from '../../../lib/client.js'
  import { escapeHtml, formatPrice, formatDate } from '../../../lib/format.js'
  import { NymbalOrderTimeline } from '@nymbalhq/web-components/elements/nymbal-order-timeline'

  NymbalOrderTimeline.define()

  const container = document.getElementById('order-detail-container')
  const orderNumber = container?.dataset.orderNumber

  async function loadOrderDetail() {
    if (!container || !orderNumber) return

    try {
      const order = await client.customer.orders.get(orderNumber)
      const ship = order.shippingAddress

      container.innerHTML = `
        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: var(--nymbal-spacing-lg, 1.5rem); flex-wrap: wrap; gap: var(--nymbal-spacing-sm, 0.5rem);">
          <div>
            <h1 class="account-page-title" style="margin-bottom: 0;">Order #${escapeHtml(order.orderNumber)}</h1>
            ${order.createdAt ? `<p class="account-page-subtitle" style="margin-top: var(--nymbal-spacing-xs, 0.25rem);">${formatDate(order.createdAt)}</p>` : ''}
          </div>
          <span class="order-status status-${escapeHtml(order.status)}">${escapeHtml(order.status)}</span>
        </div>

        ${order.timeline?.length ? `<nymbal-order-timeline style="display: block; margin-bottom: var(--nymbal-spacing-lg, 1.5rem);" entries="${escapeHtml(JSON.stringify(order.timeline))}"></nymbal-order-timeline>` : ''}

        <div class="confirmation-card">
          <h2 class="confirmation-card-title">Items</h2>
          <div class="confirmation-items" style="margin-top: 0; padding-top: 0; border-top: none;">
            ${(order.lineItems ?? [])
              .map(
                (item) => `
              <div class="confirmation-item">
                <span>
                  <span class="confirmation-item-name">${escapeHtml(item.productName)}</span>
                  ${item.variantName ? ` - ${escapeHtml(item.variantName)}` : ''}
                  <span class="confirmation-item-qty"> x${item.qty}</span>
                </span>
                <span class="confirmation-item-price">${formatPrice(item.lineTotalMinor, order.currency)}</span>
              </div>
            `,
              )
              .join('')}
          </div>

          <div class="confirmation-totals">
            <div class="confirmation-total-row">
              <span>Subtotal</span>
              <span>${formatPrice(order.subtotalMinor, order.currency)}</span>
            </div>
            ${order.shippingTotalMinor != null ? `
              <div class="confirmation-total-row">
                <span>Shipping</span>
                <span>${order.shippingTotalMinor === 0 ? 'Free' : formatPrice(order.shippingTotalMinor, order.currency)}</span>
              </div>
            ` : ''}
            ${order.taxTotalMinor != null ? `
              <div class="confirmation-total-row">
                <span>Tax</span>
                <span>${formatPrice(order.taxTotalMinor, order.currency)}</span>
              </div>
            ` : ''}
            <div class="confirmation-total-row grand-total">
              <span>Total</span>
              <span>${formatPrice(order.totalMinor, order.currency)}</span>
            </div>
          </div>
        </div>

        ${ship ? `
          <div class="confirmation-card">
            <h2 class="confirmation-card-title">Shipping Address</h2>
            <p style="font-size: var(--nymbal-font-size-sm, 0.875rem); color: var(--nymbal-color-text-muted, #71717a); line-height: 1.6;">
              ${escapeHtml(`${ship.firstName} ${ship.lastName}`)}<br/>
              ${escapeHtml(ship.addressLine1)}<br/>
              ${ship.addressLine2 ? escapeHtml(ship.addressLine2) + '<br/>' : ''}
              ${escapeHtml(`${ship.city}, ${ship.region} ${ship.postalCode}`)}<br/>
              ${escapeHtml(ship.country)}
            </p>
          </div>
        ` : ''}

        <a href="/account/orders" class="btn btn-secondary" style="margin-top: var(--nymbal-spacing-md, 1rem);">Back to Orders</a>
      `
    } catch {
      container.innerHTML = `
        <div class="account-empty">
          <h2 class="account-empty-title">Unable to load order</h2>
          <p class="account-empty-text">Please try again later.</p>
          <a href="/account/orders" class="btn btn-secondary">Back to Orders</a>
        </div>
      `
    }
  }

  loadOrderDetail()
</script>
