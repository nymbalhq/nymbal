---
import '../../styles/pages/account.css'
import BaseLayout from '../../layouts/BaseLayout.astro'
---

<BaseLayout title="Create Account | Nymbal" description="Create a new Nymbal account.">
  <div class="auth-page">
    <div class="auth-card">
      <h1 class="auth-card-title">Create Account</h1>
      <p class="auth-card-subtitle">Join us and start shopping.</p>

      <div class="checkout-error" id="register-error" style="display:none; margin-bottom: var(--nymbal-spacing-md, 1rem);" role="alert"></div>

      <form id="register-form" data-testid="register-form">
        <div class="account-form-row">
          <div class="form-group">
            <label for="register-firstName">First Name</label>
            <input
              type="text"
              id="register-firstName"
              name="firstName"
              autocomplete="given-name"
              placeholder="First name"
              data-testid="register-firstName"
            />
          </div>

          <div class="form-group">
            <label for="register-lastName">Last Name</label>
            <input
              type="text"
              id="register-lastName"
              name="lastName"
              autocomplete="family-name"
              placeholder="Last name"
              data-testid="register-lastName"
            />
          </div>
        </div>

        <div class="form-group">
          <label for="register-email">Email</label>
          <input
            type="email"
            id="register-email"
            name="email"
            required
            autocomplete="email"
            placeholder="you@example.com"
            data-testid="register-email"
          />
        </div>

        <div class="form-group">
          <label for="register-password">Password</label>
          <input
            type="password"
            id="register-password"
            name="password"
            required
            autocomplete="new-password"
            placeholder="Choose a password"
            minlength="8"
            data-testid="register-password"
          />
        </div>

        <div class="form-group">
          <label for="register-phone">Phone (optional)</label>
          <input
            type="tel"
            id="register-phone"
            name="phone"
            autocomplete="tel"
            placeholder="+44 7700 900000"
            data-testid="register-phone"
          />
        </div>

        <button type="submit" class="btn btn-primary" data-testid="register-submit">
          Create Account
        </button>
      </form>

      <p class="auth-footer">
        Already have an account? <a href="/account/login">Sign in</a>
      </p>
    </div>
  </div>
</BaseLayout>

<script>
  import '../../scripts/auth-forms.js'
</script>
