---
import '../../styles/pages/account.css'
import NymbalElement from '@nymbalhq/web-components/astro'
import BaseLayout from '../../layouts/BaseLayout.astro'
---

<BaseLayout title="Set a New Password | Nymbal" description="Choose a new password for your account.">
  <div class="auth-page">
    <div class="auth-card">
      <h1 class="auth-card-title">Set a New Password</h1>
      <p class="auth-card-subtitle">Choose a password of at least 8 characters.</p>

      <NymbalElement tag="nymbal-reset-password-form" />

      <p class="auth-footer">
        <a href="/account/login">Back to sign in</a>
      </p>
    </div>
  </div>
</BaseLayout>

<script>
  import '../../lib/client.js'
  import { NymbalResetPasswordForm } from '@nymbalhq/web-components/elements/nymbal-reset-password-form'
  import '../../scripts/signed-in-redirect.js'

  NymbalResetPasswordForm.define()
</script>
