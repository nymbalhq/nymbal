---
import '../styles/pages/home.css'
import NymbalElement from '@nymbalhq/web-components/astro'
import { cardImageOf, cardProductOf } from '@nymbalhq/web-components/ssr'
import BaseLayout from '../layouts/BaseLayout.astro'
import HeroSection from '../components/HeroSection.astro'
import NewsletterSignup from '../components/NewsletterSignup.astro'
import { fetchProducts, fetchCategories } from '../lib/api'
import { organizationJsonLd } from '../lib/seo'

const [productResult, categories] = await Promise.all([
  fetchProducts({ limit: 8 }),
  fetchCategories(),
])
const products = productResult.items.map(cardProductOf)
// The first card's image is the page's likely LCP, and the preload scanner never reaches it inside the grid's shadow
// root: the head starts it.
const firstImage = products[0] === undefined ? null : cardImageOf(products[0]).url

const jsonLd = organizationJsonLd('Nymbal', Astro.url.origin)
---

<BaseLayout title="Nymbal — Modern Storefront" jsonLd={jsonLd}>
  {firstImage && <link slot="head" rel="preload" as="image" href={firstImage} fetchpriority="high" />}
  <HeroSection />

  <section class="section container">
    <h2 class="section-title">Shop by Category</h2>
    <NymbalElement tag="nymbal-category-nav" attributes={{ categories: JSON.stringify(categories) }} />
  </section>

  <section class="featured-section section">
    <div class="container">
      <div class="featured-header">
        <h2 class="section-title" style="margin-bottom: 0;">Featured Products</h2>
        <a href="/products" class="featured-link">View all</a>
      </div>
      <NymbalElement tag="nymbal-product-grid" attributes={{ products: JSON.stringify(products) }} />
    </div>
  </section>

  <NewsletterSignup />

  <!-- The shopper's own list, read in the browser: a bare tag, so no shopper's list is in the page's HTML. -->
  <div class="container">
    <nymbal-recently-viewed data-testid="recently-viewed"></nymbal-recently-viewed>
  </div>
</BaseLayout>

<script>
  import '../lib/client.js'
  import { NymbalCategoryNav } from '@nymbalhq/web-components/elements/nymbal-category-nav'
  import { NymbalProductGrid } from '@nymbalhq/web-components/elements/nymbal-product-grid'
  import { NymbalRecentlyViewed } from '@nymbalhq/web-components/elements/nymbal-recently-viewed'

  NymbalCategoryNav.define()
  NymbalProductGrid.define()
  NymbalRecentlyViewed.define()
</script>
