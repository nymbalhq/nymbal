---
import '../styles/pages/home.css'
import NymbalElement from '@nymbalhq/web-components/astro'
import { cardProductOf } from '@nymbalhq/web-components/ssr'
import BaseLayout from '../layouts/BaseLayout.astro'
import HeroSection from '../components/HeroSection.astro'
import NewsletterSignup from '../components/NewsletterSignup.astro'
import { fetchProducts, fetchCategories } from '../lib/api'
import { organizationJsonLd } from '../lib/seo'

const [productResult, categories] = await Promise.all([
  fetchProducts({ limit: 8 }),
  fetchCategories(),
])

const jsonLd = organizationJsonLd('Nymbal', Astro.url.origin)
---

<BaseLayout title="Nymbal — Modern Storefront" jsonLd={jsonLd}>
  <HeroSection />

  <section class="section container">
    <h2 class="section-title">Shop by Category</h2>
    <NymbalElement tag="nymbal-category-nav" attributes={{ categories: JSON.stringify(categories) }} />
  </section>

  <section class="featured-section section">
    <div class="container">
      <div class="featured-header">
        <h2 class="section-title" style="margin-bottom: 0;">Featured Products</h2>
        <a href="/products" class="featured-link">View all</a>
      </div>
      <NymbalElement tag="nymbal-product-grid" attributes={{ products: JSON.stringify(productResult.items.map(cardProductOf)) }} />
    </div>
  </section>

  <NewsletterSignup />
</BaseLayout>

<script>
  import '../lib/client.js'
  import { NymbalCategoryNav } from '@nymbalhq/web-components/elements/nymbal-category-nav'
  import { NymbalProductGrid } from '@nymbalhq/web-components/elements/nymbal-product-grid'

  NymbalCategoryNav.define()
  NymbalProductGrid.define()
</script>
