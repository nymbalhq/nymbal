---
import { STOCK_LABELS, stockLevel } from '@nymbalhq/types'

interface Props {
  stock: number
}

const { stock } = Astro.props
const level = stockLevel(stock)
---

<span class="pdp-stock" data-testid="stock-badge" data-level={level}>
  <span class="pdp-stock-dot" aria-hidden="true"></span>
  <span data-stock-label>{STOCK_LABELS[level]}</span>
</span>
