---
import { formatPrice } from '../lib/format'

interface Props {
  product: {
    slug: string
    name: string
    priceMinor: number | null
    priceRange?: { minMinor: number } | null
    currency: string | null
    media: any
    imageUrl?: string
  }
  /** The card is in a listing's first row, so its image is the page's likely LCP: fetched at once, not lazily. */
  eager?: boolean
}

const { product, eager = false } = Astro.props
const imageUrl =
  product.imageUrl ??
  (Array.isArray(product.media) && product.media[0]?.url) ??
  `https://picsum.photos/seed/${product.slug}/600/600`
// The "from" price, which the price sorts order by.
const fromMinor = product.priceRange?.minMinor ?? product.priceMinor
const price =
  fromMinor != null ? formatPrice(fromMinor, product.currency ?? 'GBP') : ''
---

<a
  href={`/product/${product.slug}`}
  class="product-card"
  data-testid={`product-card-${product.slug}`}
>
  <img
    src={imageUrl}
    alt={product.name}
    class="product-card-image"
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : undefined}
    width="600"
    height="600"
  />
  <div class="product-card-body">
    <span class="product-card-name">{product.name}</span>
    {price && <span class="product-card-price">{price}</span>}
  </div>
</a>
