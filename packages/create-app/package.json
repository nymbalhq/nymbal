{
  "name": "create-nymbal-app",
  "version": "0.1.0",
  "description": "Scaffold a new Nymbal commerce project",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "create-nymbal-app": "./bin/create-nymbal-app.mjs"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "bin",
    "dist",
    "scaffold"
  ],
  "scripts": {
    "build": "tsup && pnpm sync:scaffold",
    "dev": "tsup --watch",
    "sync:scaffold": "node ./scripts/sync-scaffold.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@clack/prompts": "^0.7.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.6.3"
  }
}
