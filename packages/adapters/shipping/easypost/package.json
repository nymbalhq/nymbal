{
  "name": "@nymbalhq/shipping-easypost",
  "version": "1.5.0",
  "description": "EasyPost shipping for Nymbal: the `easypost` shipping provider (tracker webhooks deliver shipped orders)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nymbalhq/nymbal.git",
    "directory": "packages/adapters/shipping/easypost"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit --rootDir ../../../.."
  },
  "peerDependencies": {
    "@nymbalhq/types": "^1.5.0"
  },
  "devDependencies": {
    "@nymbalhq/types": "workspace:*",
    "@typescript/native": "npm:typescript@^7.0.2",
    "fast-check": "^4.10.2",
    "tsup": "^9.0.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^3.0.0"
  }
}
