{
  "name": "@nymbalhq/document-store-redis",
  "version": "1.5.0",
  "description": "The Redis document store for Nymbal: `infrastructure.documentStore: { provider: 'redis' }`",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nymbalhq/nymbal.git",
    "directory": "packages/adapters/document-store/redis"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./recipes/*": "./recipes/*"
  },
  "files": [
    "dist",
    "recipes"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit --rootDir ../../../.."
  },
  "peerDependencies": {
    "@nymbalhq/types": "^1.5.0",
    "ioredis": "^5.4.0 || ^6.0.0"
  },
  "devDependencies": {
    "@nymbalhq/contract-tests": "workspace:*",
    "@nymbalhq/types": "workspace:*",
    "@typescript/native": "npm:typescript@^7.0.2",
    "fast-check": "^4.10.2",
    "ioredis": "^6.0.0",
    "tsup": "^9.0.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^3.0.0"
  }
}
