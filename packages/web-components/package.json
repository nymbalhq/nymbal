{
  "name": "@nymbalhq/web-components",
  "version": "1.0.0",
  "description": "Interactive commerce UI as native Web Components",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nymbalhq/nymbal.git",
    "directory": "packages/web-components"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens.css": "./src/tokens/tokens.css"
  },
  "files": [
    "dist",
    "src/tokens/tokens.css"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@nymbalhq/sdk": "workspace:*",
    "@nymbalhq/types": "workspace:*",
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.6.3"
  }
}
