{
  "name": "@nymbalhq/http",
  "version": "0.1.0",
  "description": "Framework-agnostic HTTP abstraction with Fastify adapter",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nymbalhq/nymbal.git",
    "directory": "packages/http"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "^9.4.0",
    "@fastify/cors": "^8.5.0",
    "@nymbalhq/config": "workspace:*",
    "@nymbalhq/types": "workspace:*",
    "fastify": "^4.28.1",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@types/uuid": "^10.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3"
  }
}
