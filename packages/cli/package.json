{
  "name": "@nymbal/cli",
  "version": "0.1.0",
  "description": "nymbal — developer CLI for the Nymbal platform",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "nymbal": "./bin/nymbal.mjs"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@clack/prompts": "^0.7.0",
    "@nymbal/config": "workspace:*",
    "@nymbal/http": "workspace:*",
    "@nymbal/importers": "workspace:*",
    "@nymbal/platform": "workspace:*",
    "@nymbal/types": "workspace:*",
    "citty": "^0.1.6",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.6.3"
  }
}
