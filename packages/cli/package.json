{
  "name": "nymbal",
  "version": "1.2.0",
  "description": "nymbal — developer CLI for the Nymbal platform",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nymbalhq/nymbal.git",
    "directory": "packages/cli"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "nymbal": "./bin/nymbal.mjs"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit --rootDir ../.."
  },
  "dependencies": {
    "@clack/prompts": "^0.7.0",
    "@nymbalhq/admin": "workspace:*",
    "@nymbalhq/config": "workspace:*",
    "@nymbalhq/http": "workspace:*",
    "@nymbalhq/importers": "workspace:*",
    "@nymbalhq/platform": "workspace:*",
    "@nymbalhq/types": "workspace:*",
    "citty": "^0.1.6",
    "magicast": "^0.5.5",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@typescript/native": "npm:typescript@^7.0.2",
    "tsup": "^9.0.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
