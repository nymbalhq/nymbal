{
  "name": "@nymbalhq/platform",
  "version": "1.4.0",
  "description": "Nymbal CQRS kernel (command store, document store, event bus)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nymbalhq/nymbal.git",
    "directory": "packages/platform"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/db/schema/index.d.ts",
      "import": "./dist/db/schema/index.js"
    },
    "./recipes/*": "./recipes/*"
  },
  "files": [
    "dist",
    "drizzle.config.sqlite.ts",
    "drizzle.config.postgres.ts",
    "migrations",
    "recipes"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit --rootDir ../..",
    "db:generate:sqlite": "drizzle-kit generate --config=drizzle.config.sqlite.ts",
    "db:generate:postgres": "drizzle-kit generate --config=drizzle.config.postgres.ts",
    "db:migrate:sqlite": "drizzle-kit migrate --config=drizzle.config.sqlite.ts",
    "db:migrate:postgres": "drizzle-kit migrate --config=drizzle.config.postgres.ts"
  },
  "dependencies": {
    "@nymbalhq/config": "workspace:*",
    "@nymbalhq/types": "workspace:*",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.11.1",
    "drizzle-orm": "^0.36.0",
    "jose": "^5.9.6",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "peerDependencies": {
    "@nymbalhq/adapter-anthropic": "workspace:^",
    "@nymbalhq/adapter-easypost": "workspace:^",
    "@nymbalhq/adapter-mailgun": "workspace:^",
    "@nymbalhq/adapter-resend": "workspace:^",
    "@nymbalhq/adapter-ses": "workspace:^",
    "@nymbalhq/adapter-smtp": "workspace:^",
    "@nymbalhq/adapter-stripe": "workspace:^",
    "@nymbalhq/doc-store-postgres-jsonb": "workspace:^",
    "@nymbalhq/doc-store-redis": "workspace:^",
    "@nymbalhq/event-bus-redis-streams": "workspace:^",
    "@nymbalhq/media-s3": "workspace:^",
    "@nymbalhq/security-cloudflare": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@nymbalhq/adapter-anthropic": {
      "optional": true
    },
    "@nymbalhq/adapter-easypost": {
      "optional": true
    },
    "@nymbalhq/adapter-mailgun": {
      "optional": true
    },
    "@nymbalhq/adapter-resend": {
      "optional": true
    },
    "@nymbalhq/adapter-ses": {
      "optional": true
    },
    "@nymbalhq/adapter-smtp": {
      "optional": true
    },
    "@nymbalhq/adapter-stripe": {
      "optional": true
    },
    "@nymbalhq/doc-store-postgres-jsonb": {
      "optional": true
    },
    "@nymbalhq/doc-store-redis": {
      "optional": true
    },
    "@nymbalhq/event-bus-redis-streams": {
      "optional": true
    },
    "@nymbalhq/media-s3": {
      "optional": true
    },
    "@nymbalhq/security-cloudflare": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nymbalhq/adapter-anthropic": "workspace:*",
    "@nymbalhq/adapter-easypost": "workspace:*",
    "@nymbalhq/adapter-mailgun": "workspace:*",
    "@nymbalhq/adapter-resend": "workspace:*",
    "@nymbalhq/adapter-ses": "workspace:*",
    "@nymbalhq/adapter-smtp": "workspace:*",
    "@nymbalhq/adapter-stripe": "workspace:*",
    "@nymbalhq/doc-store-postgres-jsonb": "workspace:*",
    "@nymbalhq/doc-store-redis": "workspace:*",
    "@nymbalhq/event-bus-redis-streams": "workspace:*",
    "@nymbalhq/media-s3": "workspace:*",
    "@nymbalhq/security-cloudflare": "workspace:*",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.11",
    "@types/pg": "^8.11.10",
    "@types/uuid": "^10.0.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "drizzle-kit": "^0.28.0",
    "stripe": "^17.4.0",
    "tsup": "^9.0.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^3.0.0"
  }
}
