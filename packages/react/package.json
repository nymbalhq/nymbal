{
  "name": "@nymbalhq/react",
  "version": "1.2.0",
  "description": "React bindings for the Nymbal commerce SDK",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nymbalhq/nymbal.git",
    "directory": "packages/react"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsx scripts/generate-wrappers.ts && tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit --rootDir ../..",
    "generate": "tsx scripts/generate-wrappers.ts",
    "check:generated": "tsx scripts/generate-wrappers.ts --check"
  },
  "dependencies": {
    "@nymbalhq/sdk": "workspace:*",
    "@nymbalhq/web-components": "workspace:*",
    "@nymbalhq/types": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^9.0.0",
    "tsx": "^4.19.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^3.0.0"
  }
}
