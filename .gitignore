# Scaffold smoke-test projects (create-nymbal-app output) — throwaway dirs
# created in the repo root by CI scaffold-smoke and local launch proofs. They
# are listed as workspace members in pnpm-workspace.yaml so `pnpm install` can
# link the unpublished @nymbalhq/* packages into them, but they must never be
# committed.
/smoke-astro/
/smoke-nextjs/
/launch-smoke-astro/

# Generated reports (mutation, census) and Stryker sandbox
reports/
.stryker-tmp/

# Next 16 writes an AGENTS.md into the app on `next dev`/`next build`; it is not ours to ship.
templates/nextjs/AGENTS.md
packages/create-app/scaffold/templates/nextjs/AGENTS.md

# `next dev` and `next build` write different next-env.d.ts files; Next regenerates it, so it is not tracked.
templates/nextjs/next-env.d.ts
packages/create-app/scaffold/templates/nextjs/next-env.d.ts
