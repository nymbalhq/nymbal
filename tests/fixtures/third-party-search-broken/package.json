    "prepare": "node -e \"const fs=require('fs'),path=require('path');for(const d of new Set([process.cwd(),process.env.INIT_CWD||process.cwd()]))fs.writeFileSync(path.join(d,'script-ran-prepare'),'')\"",
    "prepack": "node -e \"const fs=require('fs'),path=require('path');for(const d of new Set([process.cwd(),process.env.INIT_CWD||process.cwd()]))fs.writeFileSync(path.join(d,'script-ran-prepack'),'')\""
