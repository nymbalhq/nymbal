+// S010: the pass runs unchanged, but every transaction it opens is rolled back once its callback returns, so no
+// claim (and no expiry delete) is durable. The cart.abandoned.v1 events the callback tried to append are published
+// again afterwards, outside any transaction, deduped only by this process's Set: a restart or a second replica
+// notifies the same cart again.
+export function startCartAbandonmentSweeper(deps: CartAbandonmentSweeperDeps): SweeperHandle {
+  type Abandoned = { cartId: string; lastActivityAt: string }
+  const notified = new Set<string>()
+  const pending: Abandoned[] = []
+  const rollback = new Error('S010: claim rolled back')
+  let inside = 0
+  const store: CartAbandonmentSweeperDeps['store'] = {
+    kind: deps.store.kind,
+    read: (fn) => deps.store.read(fn),
+    close: () => deps.store.close(),
+    async transaction(fn) {
+      let result: unknown
+      inside += 1
+      try {
+        await deps.store.transaction(async (tx) => {
+          result = await fn(tx)
+          throw rollback
+        })
+      } catch (err) {
+        if (err !== rollback) throw err
+      } finally {
+        inside -= 1
+      }
+      for (const payload of pending.splice(0)) {
+        if (notified.has(payload.cartId)) continue
+        notified.add(payload.cartId)
+        await deps.publisher.publish('cart.abandoned.v1', payload)
+      }
+      return result as never
+    },
+  }
