+    publishMany: (events) => deps.publisher.publishMany(events),
+    correlated: (id) => deps.publisher.correlated(id),
+    async publish(type, payload, options) {
+      if (inside > 0 && type === 'cart.abandoned.v1') pending.push(payload as Abandoned)
+      return deps.publisher.publish(type, payload, options)
+    },
+  }
+  const carts = Object.assign(Object.create(Object.getPrototypeOf(deps.carts)), deps.carts, {
+    store,
+  })
+  return startClaimingCartAbandonmentSweeper({ ...deps, store, carts, publisher })
