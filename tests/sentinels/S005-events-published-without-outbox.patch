# suite: pnpm vitest run --project platform-integration packages/platform/tests/integration/outbox.test.ts packages/platform/tests/integration/outbox-outside-transaction.test.ts
diff --git a/packages/platform/src/events/publisher.ts b/packages/platform/src/events/publisher.ts
--- a/packages/platform/src/events/publisher.ts
+++ b/packages/platform/src/events/publisher.ts
@@ -68,8 +68,9 @@
     async publish(type, payload, options) {
       const event = build(type, payload, options ?? {})
