{
  "name": "@nymbalhq/admin",
  "version": "1.0.0",
  "description": "The Nymbal admin, a static single-page app that `nymbal dev` serves at /admin/",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nymbalhq/nymbal.git",
    "directory": "apps/admin"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite --port 5173",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "prepack": "test -f dist/index.html || { echo \"@nymbalhq/admin: dist/index.html is missing; run pnpm --filter @nymbalhq/admin build first\" >&2; exit 1; }"
  },
  "devDependencies": {
    "@nymbalhq/types": "workspace:*",
    "@radix-ui/react-checkbox": "^1.1.2",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-popover": "^1.1.2",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.1",
    "@radix-ui/react-tooltip": "^1.1.3",
    "@tanstack/react-query": "^5.56.0",
    "@tanstack/react-virtual": "^3.10.0",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.0",
    "jsdom": "^25.0.1",
    "lucide-react": "^0.462.0",
    "postcss": "^8.4.47",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "tailwind-merge": "^2.5.0",
    "tailwindcss": "^3.4.13",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^5.4.8",
    "vitest": "^3.0.0",
    "zustand": "^5.0.0"
  }
}
