{
  "name": "nymbal-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Open source enterprise commerce platform",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "build": "pnpm -r --filter './packages/**' build",
    "build:templates": "pnpm -r --filter './templates/**' build",
    "test": "vitest run --project '!integration-*' --exclude 'packages/proof-kit/tests/services/**'",
    "test:watch": "vitest",
    "typecheck": "tsc -b && pnpm --filter @nymbalhq/template-nextjs typecheck && pnpm --filter @nymbalhq/template-astro typecheck",
    "typecheck:astro": "pnpm --filter @nymbalhq/template-astro typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "pnpm -r exec rm -rf dist .turbo node_modules/.cache",
    "dev": "pnpm --filter nymbal dev",
    "mutation": "stryker run",
    "mutation:integration": "stryker run stryker.integration.config.mjs",
    "mutation:ratchet": "tsx scripts/mutation-ratchet.ts",
    "census": "tsx scripts/test-census.ts",
    "sentinels": "tsx scripts/sentinels.ts --suite \"pnpm vitest run --project '!tooling' --exclude 'packages/platform/tests/postgres/**' --exclude 'packages/proof-kit/tests/services/**' --exclude 'packages/adapters/document-store/*/src/**' --exclude 'packages/adapters/event-bus/*/src/**' --exclude 'packages/platform/tests/primitives/**' --exclude 'tests/stores/**' --exclude 'packages/platform/tests/integration/search-performance.test.ts'\"",
    "gate": "tsx scripts/gate.ts",
    "gate:full": "tsx scripts/gate.ts --full",
    "stack": "tsx scripts/stack.ts",
    "perf:budgets": "tsx scripts/perf-budgets.ts"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@lhci/cli": "0.15.1",
    "@nymbalhq/ai-anthropic": "workspace:*",
    "@nymbalhq/config": "workspace:*",
    "@nymbalhq/document-store-postgres-jsonb": "workspace:*",
    "@nymbalhq/document-store-redis": "workspace:*",
    "@nymbalhq/email-mailgun": "workspace:*",
    "@nymbalhq/email-resend": "workspace:*",
    "@nymbalhq/email-ses": "workspace:*",
    "@nymbalhq/email-smtp": "workspace:*",
    "@nymbalhq/event-bus-redis-streams": "workspace:*",
    "@nymbalhq/media-s3": "workspace:*",
    "@nymbalhq/payments-stripe": "workspace:*",
    "@nymbalhq/security-cloudflare": "workspace:*",
    "@nymbalhq/shipping-easypost": "workspace:*",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^22.9.0",
    "@types/semver": "^7.8.0",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^3.0.0",
    "@vitest/eslint-plugin": "1.6.27",
    "chrome-launcher": "1.2.2",
    "eslint": "^9.14.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-playwright": "2.12.1",
    "fast-check": "^4.10.2",
    "happy-dom": "^16.0.0",
    "jsdom": "^29.0.2",
    "lighthouse": "12.6.1",
    "prettier": "^3.3.3",
    "puppeteer-core": "24.43.1",
    "semver": "^7.8.5",
    "tsup": "^9.0.0",
    "tsx": "^4.19.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^3.0.0"
  }
}
