{
  "name": "nymbal-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Open source enterprise commerce platform",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.12.3",
  "scripts": {
    "build": "pnpm -r --filter './packages/**' build",
    "build:templates": "pnpm -r --filter './templates/**' build",
    "test": "vitest run --project '!integration-postgres'",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "pnpm -r exec rm -rf dist .turbo node_modules/.cache",
    "dev": "pnpm --filter nymbal dev",
    "mutation": "stryker run",
    "census": "tsx scripts/test-census.ts",
    "sentinels": "tsx scripts/sentinels.ts --suite \"pnpm vitest run --project '!tooling' --exclude 'packages/platform/tests/postgres/**'\"",
    "gate": "tsx scripts/gate.ts",
    "gate:full": "tsx scripts/gate.ts --full"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@lhci/cli": "0.15.1",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^22.9.0",
    "@typescript-eslint/eslint-plugin": "^8.12.2",
    "@typescript-eslint/parser": "^8.12.2",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9.14.0",
    "eslint-config-prettier": "^9.1.0",
    "fast-check": "^4.10.2",
    "happy-dom": "^16.0.0",
    "jsdom": "^29.0.2",
    "prettier": "^3.3.3",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^3.0.0"
  }
}
