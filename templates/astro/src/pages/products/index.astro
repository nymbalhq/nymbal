---
import '../../styles/pages/plp.css'
import BaseLayout from '../../layouts/BaseLayout.astro'
import NymbalElement from '@nymbalhq/web-components/astro'
import { cardProductOf } from '@nymbalhq/web-components/ssr'
import { PRODUCT_SORT_LABELS } from '@nymbalhq/types'
import { fetchProducts, fetchCategories, fetchCapabilities, sortFromUrl } from '../../lib/api'

const capabilities = await fetchCapabilities()
const sortKeys = capabilities?.catalog.sortKeys ?? []
const sort = sortFromUrl(Astro.url, capabilities?.catalog)

const [productResult, categories] = await Promise.all([
  fetchProducts({ limit: 24, sort }),
  fetchCategories(),
])

const products = productResult.items
const facets = productResult.facets ?? []
---

<BaseLayout title="All Products | Nymbal" description="Browse our full product collection.">
  <div class="container section">
    <NymbalElement tag="nymbal-breadcrumb" attributes={{ items: JSON.stringify([{ label: 'Home', href: '/' }, { label: 'Products' }]) }} />

    <div class="plp-header">
      <h1 class="plp-title">All Products</h1>
    </div>

    <div class="plp-layout">
      <aside class="plp-sidebar">
        {facets.length > 0 && (
          <nymbal-product-filter
            facets={JSON.stringify(facets)}
          ></nymbal-product-filter>
        )}
      </aside>

      <div class="plp-grid-area">
        {sortKeys.length > 0 && (
          <div class="plp-sort-bar">
            <label for="sort-select">Sort by</label>
            <nymbal-sort-dropdown
              sort-keys={JSON.stringify(sortKeys)}
              value={sort}
              default-sort={capabilities?.catalog.defaultSort}
            >
              <select id="sort-select" data-testid="sort-dropdown">
                {sortKeys.map((key) => (
                  <option value={key} selected={key === sort}>{PRODUCT_SORT_LABELS[key]}</option>
                ))}
              </select>
            </nymbal-sort-dropdown>
          </div>
        )}

        <NymbalElement
          tag="nymbal-product-grid"
          attributes={{
            products: JSON.stringify(products.map(cardProductOf)),
            source: 'product-list',
            ...(productResult.nextCursor !== null && { 'has-more': '' }),
          }}
        />
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  import '../../scripts/plp.js'
</script>
