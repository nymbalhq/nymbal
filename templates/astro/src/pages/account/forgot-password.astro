---
import '../../styles/pages/account.css'
import NymbalElement from '@nymbalhq/web-components/astro'
import BaseLayout from '../../layouts/BaseLayout.astro'
---

<BaseLayout title="Forgot Password | Nymbal" description="Get a link to set a new password.">
  <div class="auth-page">
    <div class="auth-card">
      <h1 class="auth-card-title">Forgot Password</h1>
      <p class="auth-card-subtitle">Enter your email and we will send you a link to set a new one.</p>

      <NymbalElement tag="nymbal-forgot-password-form" />

      <p class="auth-footer">
        Remembered it? <a href="/account/login">Sign in</a>
      </p>
    </div>
  </div>
</BaseLayout>

<script>
  import '../../lib/client.js'
  import { NymbalForgotPasswordForm } from '@nymbalhq/web-components/elements/nymbal-forgot-password-form'

  NymbalForgotPasswordForm.define()
</script>
