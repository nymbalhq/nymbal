---
import '../../styles/pages/account.css'
import BaseLayout from '../../layouts/BaseLayout.astro'
---

<BaseLayout title="Sign In | Nymbal" description="Sign in to your Nymbal account.">
  <div class="auth-page">
    <div class="auth-card">
      <h1 class="auth-card-title">Sign In</h1>
      <p class="auth-card-subtitle">Welcome back. Enter your credentials to continue.</p>

      <div class="checkout-error" id="login-error" style="display:none; margin-bottom: var(--nymbal-spacing-md, 1rem);" role="alert"></div>

      <form id="login-form" data-testid="login-form">
        <div class="form-group">
          <label for="login-email">Email</label>
          <input
            type="email"
            id="login-email"
            name="email"
            required
            autocomplete="email"
            placeholder="you@example.com"
            data-testid="login-email"
          />
        </div>

        <div class="form-group">
          <label for="login-password">Password</label>
          <input
            type="password"
            id="login-password"
            name="password"
            required
            autocomplete="current-password"
            placeholder="Your password"
            data-testid="login-password"
          />
        </div>

        <button type="submit" class="btn btn-primary" data-testid="login-submit">
          Sign In
        </button>
      </form>

      <p class="auth-footer">
        Don't have an account? <a href="/account/register">Create one</a>
      </p>
    </div>
  </div>
</BaseLayout>

<script>
  import '../../scripts/auth-forms.js'
</script>
