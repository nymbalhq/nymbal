---
import '../../styles/pages/account.css'
import NymbalElement from '@nymbalhq/web-components/astro'
import BaseLayout from '../../layouts/BaseLayout.astro'
---

<BaseLayout title="Sign In | Nymbal" description="Sign in to your Nymbal account.">
  <div class="auth-page">
    <div class="auth-card">
      <h1 class="auth-card-title">Sign In</h1>
      <p class="auth-card-subtitle">Welcome back. Enter your credentials to continue.</p>

      <NymbalElement tag="nymbal-login-form" />

      <p class="auth-footer">
        Don't have an account? <a href="/account/register">Create one</a>
      </p>
    </div>
  </div>
</BaseLayout>

<script>
  import '../../lib/client.js'
  import { NymbalLoginForm } from '@nymbalhq/web-components/elements/nymbal-login-form'
  import '../../scripts/signed-in-redirect.js'

  NymbalLoginForm.define()
</script>
