---
import '../../styles/pages/confirmation.css'
import '../../styles/pages/error.css'
import BaseLayout from '../../layouts/BaseLayout.astro'
import NymbalElement from '@nymbalhq/web-components/astro'
import type { ShopperOrder } from '@nymbalhq/types'
import { fetchOrder, openExpiredOrder, requestOrderLink, shopperHeaders } from '../../lib/api'
import { isPaid, orderHeading } from '../../lib/order-status'

// The URL carries the order's key (`?key=`), so nothing this page links to or loads may be told the URL: a header,
// the meta tag below and a canonical URL without the query. No shared cache may keep what a key opened.
Astro.response.headers.set('Referrer-Policy', 'no-referrer')
Astro.response.headers.set('Cache-Control', 'no-store')

const { orderNumber } = Astro.params
const key = Astro.url.searchParams.get('key') ?? undefined

// A POST is one of the page's two forms sent without its script (the script sends both from the browser): this server
// answers it, the email in the form's body, never in a URL.
const form = Astro.request.method === 'POST' ? await Astro.request.formData() : null
const posted = (name: string): string => String(form?.get(name) ?? '').trim()
const intent = posted('intent')

// Every read rejects when the API fails, so a failed read is a 500 and never a not-found page for an order the shopper
// has.
let read: ShopperOrder | 'expired' | null
let emailLimited = false
let link: 'idle' | 'sent' | 'limited' = 'idle'
if (intent === 'link') {
  link = await requestOrderLink(
    posted('orderNumber'),
    posted('email'),
    shopperHeaders(Astro.request.headers),
  )
  read = null
} else if (intent === 'open' && key !== undefined) {
  const opened = await openExpiredOrder(
    orderNumber!,
    key,
    posted('email'),
    shopperHeaders(Astro.request.headers),
  )
  emailLimited = opened === 'limited'
  read = opened === 'limited' ? 'expired' : opened === 'not-found' ? null : opened
} else {
  read = await fetchOrder(orderNumber!, key)
}
const order = read === 'expired' ? null : read
const canonical = new URL(Astro.url.pathname, Astro.url).href

// The order page's own not-found state, which offers a fresh link; the site-wide 404 would drop the headers above.
if (read === null) Astro.response.status = 404
if (emailLimited || link === 'limited') Astro.response.status = 429

const summary = order && {
  items: JSON.stringify(
    (order.lineItems ?? []).map((item) => ({
      name: `${item.productName}${item.variantName ? ` - ${item.variantName}` : ''}`,
      qty: item.qty,
      unitPriceMinor: item.unitPriceMinor,
      lineTotalMinor: item.lineTotalMinor,
    })),
  ),
  'subtotal-minor': String(order.subtotalMinor),
  'discount-minor': String(order.discountTotalMinor ?? 0),
  'shipping-minor': String(order.shippingTotalMinor ?? 0),
  'tax-minor': String(order.taxTotalMinor ?? 0),
  'total-minor': String(order.totalMinor),
  currency: order.currency,
}

const shippingAddress = order?.shippingAddress
const heading = order ? orderHeading(order.status) : read === 'expired' ? 'Open your order' : 'Order not found'
const paid = order ? isPaid(order.status) : false
---

<BaseLayout title={`${heading} | Nymbal`} description="Your order with Nymbal." canonical={canonical}>
  <meta slot="head" name="referrer" content="no-referrer" />
  {read === 'expired' && (
    <div class="container section" id="order-email-prompt">
      <form method="post" class="error-page" id="order-email-form" data-order-number={orderNumber}>
        <input type="hidden" name="intent" value="open" />
        <h1 class="error-title">Open your order</h1>
        <p class="error-message">This order link has expired. Enter the email you gave at checkout to open the order.</p>
        <div class="form-group">
          <label for="order-email">Email</label>
          <input id="order-email" type="email" name="email" autocomplete="email" required data-testid="order-email-input" />
        </div>
        <p class="error-message" data-testid="order-email-limited" hidden={!emailLimited}>
          Too many tries for now. Please try again in a while.
        </p>
        <p class="error-message" id="order-email-failed" hidden>We could not open the order just now. Please try again.</p>
        <div class="error-actions">
          <button type="submit" class="btn btn-primary" data-testid="order-email-submit">Open order</button>
        </div>
      </form>
    </div>
  )}
  {read === 'expired' && (
    <div class="container section" id="order-opened" hidden>
      <div class="confirmation-page">
        <div class="confirmation-icon" data-order-field="paid">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
        </div>
        <h1 class="confirmation-title" data-order-field="heading"></h1>
        <p class="confirmation-subtitle" data-order-field="subtitle"></p>
        <div class="confirmation-card">
          <h2 class="confirmation-card-title">Order Details</h2>
          <dl>
            <div class="confirmation-detail-row">
              <dt>Order Number</dt>
              <dd data-order-field="number"></dd>
            </div>
            <div class="confirmation-detail-row">
              <dt>Status</dt>
              <dd style="text-transform: capitalize;" data-order-field="status"></dd>
            </div>
          </dl>
        </div>
        <nymbal-order-timeline class="confirmation-summary"></nymbal-order-timeline>
        <nymbal-order-summary class="confirmation-summary"></nymbal-order-summary>
        <div class="confirmation-card" data-order-field="shipping" hidden>
          <h2 class="confirmation-card-title">Shipping Address</h2>
          <p style="font-size: var(--nymbal-font-size-sm, 0.875rem); color: var(--nymbal-color-text-muted, #71717a); line-height: 1.6;" data-order-field="address"></p>
        </div>
        <div class="confirmation-actions">
          <a href="/account/register" class="btn btn-primary">Create an Account</a>
          <a href="/products" class="btn btn-secondary">Continue Shopping</a>
        </div>
      </div>
    </div>
  )}
  {(read === 'expired' || read === null) && (
    <div class="container section" id="order-not-found" data-order-number={orderNumber} hidden={read === 'expired'}>
      <div class="error-page">
        <span class="error-code">404</span>
        <h1 class="error-title">Order not found</h1>
        <p class="error-message">
          This link does not open an order. Give its order number and the email you gave at checkout, and we'll email
          you a fresh link if they match.
        </p>
        <form method="post" id="order-link-form" hidden={link === 'sent'}>
          <input type="hidden" name="intent" value="link" />
          <div class="form-group">
            <label for="order-link-number">Order number</label>
            <input id="order-link-number" name="orderNumber" required data-testid="order-link-number" />
          </div>
          <div class="form-group">
            <label for="order-link-email">Email</label>
            <input id="order-link-email" type="email" name="email" autocomplete="email" required data-testid="order-link-email" />
          </div>
          {link === 'limited' && <p class="error-message">Too many tries for now. Please try again in a while.</p>}
          <div class="error-actions">
            <button type="submit" class="btn btn-primary" data-testid="order-link-submit">Send me my order link</button>
          </div>
        </form>
        <p class="error-message" data-testid="order-link-sent" hidden={link !== 'sent'}>
          If that number and email match an order, its link is on its way to that email.
        </p>
        <p class="error-message" id="order-link-failed" hidden>We could not send the link just now. Please try again.</p>
      </div>
    </div>
  )}
  {order && (
    <div class="container section">
      <div class="confirmation-page" data-order-number={order.orderNumber} data-order-status={order.status}>
        {paid && (
          <div class="confirmation-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          </div>
        )}

        <h1 class="confirmation-title" data-testid="order-heading">{heading}</h1>
        {paid ? (
          <p class="confirmation-subtitle">
            Thank you. Your order <strong data-testid="order-number">{order.orderNumber}</strong> is paid.
            We'll send a confirmation to the email you gave at checkout.
          </p>
        ) : order.status === 'pending' ? (
          <p class="confirmation-subtitle">
            Your order <strong data-testid="order-number">{order.orderNumber}</strong> is waiting for its payment.
            We'll email the address you gave at checkout once it arrives.
          </p>
        ) : (
          <p class="confirmation-subtitle">
            Your order <strong data-testid="order-number">{order.orderNumber}</strong> is {order.status.replace(/_/g, ' ')}.
          </p>
        )}

        <div class="confirmation-card">
          <h2 class="confirmation-card-title">Order Details</h2>

          <dl>
            <div class="confirmation-detail-row">
              <dt>Order Number</dt>
              <dd>{order.orderNumber}</dd>
            </div>
            <div class="confirmation-detail-row">
              <dt>Status</dt>
              <dd style="text-transform: capitalize;" data-testid="order-status">{order.status}</dd>
            </div>
          </dl>
        </div>

        <NymbalElement tag="nymbal-order-timeline" attributes={{ class: 'confirmation-summary', entries: JSON.stringify(order.timeline ?? []) }} />

        <NymbalElement tag="nymbal-order-summary" attributes={{ class: 'confirmation-summary', ...summary }} />

        {shippingAddress && (
          <div class="confirmation-card">
            <h2 class="confirmation-card-title">Shipping Address</h2>
            <p style="font-size: var(--nymbal-font-size-sm, 0.875rem); color: var(--nymbal-color-text-muted, #71717a); line-height: 1.6;">
              {shippingAddress.addressLine1}<br />
              {shippingAddress.addressLine2 && <>{shippingAddress.addressLine2}<br /></>}
              {shippingAddress.city}, {shippingAddress.region} {shippingAddress.postalCode}<br />
              {shippingAddress.country}
            </p>
          </div>
        )}

        <div class="confirmation-actions">
          <a href="/account/register" class="btn btn-primary">Create an Account</a>
          <a href="/products" class="btn btn-secondary">Continue Shopping</a>
        </div>
      </div>
    </div>
  )}
</BaseLayout>

<script>
  import '../../scripts/order-status.js'
  import '../../scripts/order-access.js'
  import { NymbalOrderSummary } from '@nymbalhq/web-components/elements/nymbal-order-summary'
  import { NymbalOrderTimeline } from '@nymbalhq/web-components/elements/nymbal-order-timeline'

  NymbalOrderSummary.define()
  NymbalOrderTimeline.define()
</script>
