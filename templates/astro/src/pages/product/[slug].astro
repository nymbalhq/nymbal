---
import '../../styles/pages/pdp.css'
import BaseLayout from '../../layouts/BaseLayout.astro'
import NymbalElement from '@nymbalhq/web-components/astro'
import { cardProductOf } from '@nymbalhq/web-components/ssr'
import { loadProduct, fetchReviews, fetchProducts, fetchCapabilities } from '../../lib/api'
import { productJsonLd, breadcrumbJsonLd } from '../../lib/seo'

const { slug } = Astro.params

// Rejects when the API fails, so a failed read is a 500 and never a 404 for a product the store has.
const product = await loadProduct(slug!)
if (!product) return Astro.rewrite('/404')

const [reviewsResult, relatedResult, capabilities] = await Promise.all([
  fetchReviews(product.id),
  fetchProducts({
    limit: 4,
    category: product.categories?.[0]?.slug,
  }),
  fetchCapabilities(),
])

const reviews = reviewsResult.items ?? []
const relatedProducts = (relatedResult.items ?? []).filter((p) => p.id !== product.id).slice(0, 4)

const images = Array.isArray(product.media) && product.media.length > 0
  ? product.media.map((m: any) => ({
      url: typeof m === 'string' ? m : m.url,
      alt: typeof m === 'string' ? product.name : (m.alt ?? product.name),
    }))
  : [{ url: `https://picsum.photos/seed/${product.slug}/600/600`, alt: product.name }]

const defaultVariant = product.variants?.[0]
// A product with no variants has nothing to sell, so it reads as out of stock.
const stock = defaultVariant?.stock ?? 0

const jsonLd = productJsonLd(product, Astro.url.origin)
const breadcrumb = breadcrumbJsonLd([
  { name: 'Home', url: Astro.url.origin },
  { name: 'Products', url: `${Astro.url.origin}/products` },
  { name: product.name, url: `${Astro.url.origin}/product/${product.slug}` },
])

// The alert form only where the store's email reaches a mailbox (an API older than the report says nothing): back in
// stock for a variant out of stock, price drop for one in stock.
const offersAlerts = capabilities?.email?.delivers === true && defaultVariant !== undefined

// The selector derives its option groups from the product's variants.
const hasVariantChoice = (product.variants?.length ?? 0) > 1
---

<BaseLayout title={`${product.name} | Nymbal`} description={product.shortDescription ?? product.description ?? ''} jsonLd={jsonLd}>
  <!-- The gallery's main image is the page's LCP: the browser starts it before it parses the body. -->
  <link slot="head" rel="preload" as="image" href={images[0]!.url} fetchpriority="high" />
  <div class="container section" data-product-slug={product.slug}>
    <NymbalElement
      tag="nymbal-breadcrumb"
      attributes={{
        items: JSON.stringify([
          { label: 'Home', href: '/' },
          { label: 'Products', href: '/products' },
          { label: product.name },
        ]),
      }}
    />

    <div class="pdp-layout">
      <NymbalElement tag="nymbal-image-gallery" attributes={{ class: 'pdp-gallery', images: JSON.stringify(images) }} />

      <div class="pdp-info">
        <h1 class="pdp-title" data-testid="product-title">{product.name}</h1>

        <NymbalElement
          tag="nymbal-product-price"
          attributes={{
            'product-id': product.id,
            'price-minor': String(defaultVariant?.priceMinor ?? product.priceMinor ?? 0),
            currency: product.currency ?? 'GBP',
          }}
        />
        <NymbalElement tag="nymbal-stock-badge" attributes={{ 'product-id': product.id, stock: String(stock) }} />

        <div class="pdp-actions">
          {hasVariantChoice && (
            <NymbalElement tag="nymbal-variant-selector" attributes={{ product: JSON.stringify(product) }} />
          )}

          <div class="pdp-add-row">
            <NymbalElement tag="nymbal-quantity-selector" attributes={{ value: '1', min: '1', max: '99' }} />
            <NymbalElement
              tag="nymbal-add-to-cart"
              attributes={{
                'variant-id': defaultVariant?.id ?? product.id,
                qty: '1',
                ...(stock <= 0 && { disabled: '' }),
              }}
            />
          </div>
        </div>

        {offersAlerts && (
          <NymbalElement
            tag="nymbal-notify-me"
            attributes={{ 'product-id': product.id, 'variant-id': defaultVariant!.id, stock: String(stock) }}
          />
        )}

        {product.description && (
          <div class="pdp-description" data-testid="product-description">
            <Fragment set:html={product.description} />
          </div>
        )}
      </div>
    </div>

    <section class="pdp-reviews">
      <h2 class="pdp-reviews-title">Customer Reviews</h2>
      <NymbalElement tag="nymbal-review-list" attributes={{ reviews: JSON.stringify(reviews) }} />
      <NymbalElement tag="nymbal-review-form" attributes={{ class: 'pdp-review-form', 'product-id': product.id }} />
    </section>

    {relatedProducts.length > 0 && (
      <section class="section">
        <h2 class="section-title">You may also like</h2>
        <NymbalElement
          tag="nymbal-product-grid"
          attributes={{ products: JSON.stringify(relatedProducts.map(cardProductOf)), lazy: '' }}
        />
      </section>
    )}

    <!-- The shopper's own list, read in the browser: a bare tag, so no shopper's list is in the page's HTML. -->
    <nymbal-recently-viewed data-testid="recently-viewed" current={product.id}></nymbal-recently-viewed>
  </div>
</BaseLayout>

<script>
  import '../../scripts/pdp.js'
</script>
