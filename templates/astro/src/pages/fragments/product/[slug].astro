---
import NymbalElement from '@nymbalhq/web-components/astro'
import { cardProductOf } from '@nymbalhq/web-components/ssr'
import { fetchProduct } from '../../../lib/api'

Astro.response.headers.set('Cache-Control', 'public, s-maxage=300, stale-while-revalidate=60')
// A fragment has no <meta charset>, so the charset is in the header.
Astro.response.headers.set('Content-Type', 'text/html; charset=utf-8')

const { slug } = Astro.params
const product = await fetchProduct(slug!)

if (!product) {
  // A CDN would apply its default 404 TTL to a 404 with no Cache-Control.
  return new Response('Not found', {
    status: 404,
    headers: { 'Content-Type': 'text/plain; charset=utf-8', 'Cache-Control': 'no-store' },
  })
}
---
<NymbalElement tag="nymbal-product-card" attributes={{ product: JSON.stringify(cardProductOf(product)) }} />
