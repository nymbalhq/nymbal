---
import NymbalElement from '@nymbalhq/web-components/astro'
import { FOOTER } from '../../lib/chrome'
Astro.response.headers.set('Cache-Control', 'public, s-maxage=86400, stale-while-revalidate=300')
// A fragment has no <meta charset>, so the charset is in the header.
Astro.response.headers.set('Content-Type', 'text/html; charset=utf-8')
---
<NymbalElement tag="nymbal-site-footer" attributes={FOOTER} />
