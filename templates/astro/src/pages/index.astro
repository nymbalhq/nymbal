---
const apiUrl = import.meta.env.NYMBAL_API_URL ?? process.env.NYMBAL_API_URL ?? 'http://localhost:3001'

interface Product {
  id: string
  slug: string
  title: string
  description: string
  priceMinor: number
  currency: string
  imageUrl: string
}

let products: Product[] = []
let error: string | null = null
try {
  const res = await fetch(`${apiUrl}/api/products?limit=50`)
  if (res.ok) {
    const data = (await res.json()) as { items: Product[] }
    products = data.items
  } else {
    error = `API returned ${res.status}`
  }
} catch (err) {
  error = err instanceof Error ? err.message : String(err)
}

function formatPrice(minor: number, currency: string): string {
  try {
    return new Intl.NumberFormat('en-GB', { style: 'currency', currency }).format(minor / 100)
  } catch {
    return `${currency} ${(minor / 100).toFixed(2)}`
  }
}
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Nymbal — Astro Storefront</title>
    <style>
      :root { color-scheme: light dark; font-family: system-ui, -apple-system, sans-serif; }
      body { margin: 0; padding: 2rem; max-width: 72rem; margin-inline: auto; }
      h1 { font-size: 1.5rem; margin-bottom: 0.25rem; }
      p.lede { color: #666; margin-top: 0; }
      ul.grid { list-style: none; padding: 0; display: grid; gap: 1.25rem; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); }
      li.card { border: 1px solid rgba(0,0,0,0.1); border-radius: 8px; overflow: hidden; background: rgba(255,255,255,0.4); }
      li.card img { width: 100%; height: 160px; object-fit: cover; display: block; background: #eee; }
      .body { padding: 0.75rem 1rem 1rem; }
      .title { font-weight: 600; font-size: 0.95rem; margin: 0 0 0.25rem; }
      .price { font-weight: 500; color: #333; }
      .error { color: #b00; background: #fee; padding: 0.75rem 1rem; border-radius: 6px; }
    </style>
  </head>
  <body>
    <h1>Nymbal — Astro Storefront</h1>
    <p class="lede">Minimal starter — fetches <code>/api/products</code>. Prompt 4 builds out the full UI.</p>
    {error && <p class="error">Failed to load products: {error}</p>}
    <ul class="grid">
      {products.map((p) => (
        <li class="card">
          <img src={p.imageUrl} alt={p.title} loading="lazy" />
          <div class="body">
            <p class="title">{p.title}</p>
            <p class="price">{formatPrice(p.priceMinor, p.currency)}</p>
          </div>
        </li>
      ))}
    </ul>
  </body>
</html>
