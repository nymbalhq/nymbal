---
---
<header class="site-header" data-testid="site-header">
  <div class="header-container container">
    <a href="/" class="header-logo">Nymbal</a>

    <label class="hamburger" for="nav-toggle" aria-label="Toggle navigation">
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
    </label>
    <input type="checkbox" id="nav-toggle" class="nav-toggle visually-hidden" />

    <div class="header-nav-wrapper">
      <nav class="header-nav" aria-label="Main navigation">
        <a href="/category/apparel" class="nav-link">Apparel</a>
        <a href="/category/home" class="nav-link">Home</a>
        <a href="/category/electronics" class="nav-link">Electronics</a>
        <a href="/category/books" class="nav-link">Books</a>
        <a href="/products" class="nav-link">All Products</a>
      </nav>

      <div class="header-actions">
        <nymbal-search-bar placeholder="Search products..." debounce-ms="300"></nymbal-search-bar>
        <a href="/account" class="header-account-link" aria-label="Account">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
            <circle cx="12" cy="7" r="4" />
          </svg>
        </a>
        <nymbal-mini-cart></nymbal-mini-cart>
      </div>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--nymbal-z-index-sticky, 100);
    background-color: var(--nymbal-color-surface, #fff);
    border-bottom: 1px solid var(--nymbal-color-border, #e4e4e7);
  }

  .header-container {
    display: flex;
    align-items: center;
    gap: var(--nymbal-spacing-md, 1rem);
    padding-block: var(--nymbal-spacing-sm, 0.5rem);
    flex-wrap: wrap;
  }

  .header-logo {
    font-size: var(--nymbal-font-size-lg, 1.125rem);
    font-weight: var(--nymbal-font-weight-bold, 700);
    color: var(--nymbal-color-primary, #18181b);
    text-decoration: none;
    letter-spacing: -0.02em;
    flex-shrink: 0;
  }

  .header-logo:hover {
    color: var(--nymbal-color-accent, #2563eb);
  }

  /* Hamburger toggle */
  .hamburger {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 4px;
    width: 28px;
    height: 28px;
    cursor: pointer;
    margin-left: auto;
    padding: 2px;
  }

  .hamburger-line {
    display: block;
    width: 100%;
    height: 2px;
    background-color: var(--nymbal-color-primary, #18181b);
    border-radius: 1px;
    transition: transform var(--nymbal-transition-fast, 150ms) ease,
      opacity var(--nymbal-transition-fast, 150ms) ease;
  }

  .nav-toggle:checked ~ .header-nav-wrapper {
    display: flex;
  }

  .nav-toggle:checked ~ .hamburger .hamburger-line:nth-child(1) {
    transform: translateY(6px) rotate(45deg);
  }

  .nav-toggle:checked ~ .hamburger .hamburger-line:nth-child(2) {
    opacity: 0;
  }

  .nav-toggle:checked ~ .hamburger .hamburger-line:nth-child(3) {
    transform: translateY(-6px) rotate(-45deg);
  }

  .header-nav-wrapper {
    display: none;
    flex-direction: column;
    width: 100%;
    gap: var(--nymbal-spacing-md, 1rem);
    padding-block: var(--nymbal-spacing-sm, 0.5rem);
  }

  .header-nav {
    display: flex;
    flex-direction: column;
    gap: var(--nymbal-spacing-xs, 0.25rem);
  }

  .nav-link {
    display: block;
    padding: var(--nymbal-spacing-xs, 0.25rem) var(--nymbal-spacing-sm, 0.5rem);
    font-size: var(--nymbal-font-size-sm, 0.875rem);
    font-weight: var(--nymbal-font-weight-medium, 500);
    color: var(--nymbal-color-text, #18181b);
    text-decoration: none;
    border-radius: var(--nymbal-radius-sm, 0.25rem);
    transition: background-color var(--nymbal-transition-fast, 150ms) ease,
      color var(--nymbal-transition-fast, 150ms) ease;
  }

  .nav-link:hover {
    background-color: var(--nymbal-color-border, #e4e4e7);
    color: var(--nymbal-color-accent, #2563eb);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--nymbal-spacing-sm, 0.5rem);
  }

  .header-account-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    color: var(--nymbal-color-text, #18181b);
    text-decoration: none;
    border-radius: var(--nymbal-radius-full, 9999px);
    transition: background-color var(--nymbal-transition-fast, 150ms) ease,
      color var(--nymbal-transition-fast, 150ms) ease;
  }

  .header-account-link:hover {
    background-color: var(--nymbal-color-border, #e4e4e7);
    color: var(--nymbal-color-accent, #2563eb);
  }

  /* Desktop layout */
  @media (min-width: 769px) {
    .hamburger {
      display: none;
    }

    .header-container {
      flex-wrap: nowrap;
      padding-block: var(--nymbal-spacing-md, 1rem);
    }

    .header-nav-wrapper {
      display: flex;
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      width: auto;
      flex: 1;
      padding-block: 0;
      gap: var(--nymbal-spacing-lg, 1.5rem);
    }

    .header-nav {
      flex-direction: row;
      gap: var(--nymbal-spacing-xs, 0.25rem);
    }

    .nav-link {
      padding: var(--nymbal-spacing-xs, 0.25rem) var(--nymbal-spacing-sm, 0.5rem);
    }
  }
</style>
