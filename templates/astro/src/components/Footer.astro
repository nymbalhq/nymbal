---
const currentYear = new Date().getFullYear()
---
<footer class="site-footer" data-testid="site-footer">
  <div class="footer-container container">
    <div class="footer-grid">
      <div class="footer-column">
        <h2 class="footer-heading">Shop</h2>
        <ul class="footer-links">
          <li><a href="/products">All Products</a></li>
          <li><a href="/category/apparel">Apparel</a></li>
          <li><a href="/category/home">Home</a></li>
          <li><a href="/category/electronics">Electronics</a></li>
          <li><a href="/category/books">Books</a></li>
        </ul>
      </div>

      <div class="footer-column">
        <h2 class="footer-heading">Account</h2>
        <ul class="footer-links">
          <li><a href="/account/login">Login</a></li>
          <li><a href="/account/register">Register</a></li>
          <li><a href="/account/orders">Orders</a></li>
        </ul>
      </div>

      <div class="footer-column">
        <h2 class="footer-heading">About</h2>
        <p class="footer-about">
          Nymbal is a modern headless commerce platform built for developers.
          Fast, flexible, and fully customisable.
        </p>
      </div>
    </div>

    <div class="footer-bottom">
      <p>&copy; {currentYear} Nymbal. All rights reserved.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--nymbal-color-primary, #18181b);
    color: var(--nymbal-color-text-inverse, #fff);
    margin-top: auto;
  }

  .footer-container {
    padding-block: 3rem var(--nymbal-spacing-lg, 1.5rem);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--nymbal-spacing-xl, 2rem);
    margin-bottom: var(--nymbal-spacing-xl, 2rem);
  }

  @media (min-width: 641px) {
    .footer-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .footer-heading {
    font-size: var(--nymbal-font-size-sm, 0.875rem);
    font-weight: var(--nymbal-font-weight-bold, 700);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: var(--nymbal-spacing-md, 1rem);
    color: var(--nymbal-color-text-inverse, #fff);
  }

  .footer-links {
    display: flex;
    flex-direction: column;
    gap: var(--nymbal-spacing-sm, 0.5rem);
  }

  .footer-links a {
    font-size: var(--nymbal-font-size-sm, 0.875rem);
    color: rgba(255, 255, 255, 0.7);
    text-decoration: none;
    transition: color var(--nymbal-transition-fast, 150ms) ease;
  }

  .footer-links a:hover {
    color: var(--nymbal-color-text-inverse, #fff);
  }

  .footer-about {
    font-size: var(--nymbal-font-size-sm, 0.875rem);
    color: rgba(255, 255, 255, 0.7);
    line-height: 1.6;
    max-width: 28ch;
  }

  .footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding-top: var(--nymbal-spacing-lg, 1.5rem);
  }

  .footer-bottom p {
    font-size: var(--nymbal-font-size-xs, 0.75rem);
    color: rgba(255, 255, 255, 0.5);
  }
</style>
